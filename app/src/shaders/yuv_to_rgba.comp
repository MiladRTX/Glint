#version 450
// Decoded console picture (NV12 from D3D11VA, or I420 from the CPU decoder)
// to the RGBA display image. Compiled to SPIR-V by build.sh (glslc).

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba8) uniform writeonly image2D dst;
layout(binding = 1) uniform sampler2D plane_y;   // R8, full size
layout(binding = 2) uniform sampler2D plane_u;   // NV12: RG8 (U,V); I420: R8 (U); half size
layout(binding = 3) uniform sampler2D plane_v;   // I420: R8 (V); unused for NV12

layout(push_constant) uniform Params {
    ivec2 size;
    int nv12;
    int full_range;
    int bt709;
} pc;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= pc.size.x || p.y >= pc.size.y) return;

    float y = texelFetch(plane_y, p, 0).r;
    // Chroma is half resolution, bilinear. H.264's default siting is "left":
    // horizontally co-sited with even luma columns, vertically centred.
    // textureLod, not texture(): implicit LOD is undefined in compute shaders.
    vec2 uv_pos = vec2((float(p.x) + 1.0) / float(pc.size.x), (float(p.y) + 0.5) / float(pc.size.y));
    float u, v;
    if (pc.nv12 == 1) {
        vec2 c = textureLod(plane_u, uv_pos, 0.0).rg;
        u = c.x;
        v = c.y;
    } else {
        u = textureLod(plane_u, uv_pos, 0.0).r;
        v = textureLod(plane_v, uv_pos, 0.0).r;
    }

    if (pc.full_range == 0) {
        y = (y - 16.0 / 255.0) * (255.0 / 219.0);
        u = (u - 128.0 / 255.0) * (255.0 / 224.0);
        v = (v - 128.0 / 255.0) * (255.0 / 224.0);
    } else {
        u -= 128.0 / 255.0;
        v -= 128.0 / 255.0;
    }

    vec3 rgb;
    if (pc.bt709 == 1)
        rgb = vec3(y + 1.5748 * v, y - 0.187324 * u - 0.468124 * v, y + 1.8556 * u);
    else
        rgb = vec3(y + 1.402 * v, y - 0.344136 * u - 0.714136 * v, y + 1.772 * u);

    imageStore(dst, p, vec4(clamp(rgb, 0.0, 1.0), 1.0));
}
