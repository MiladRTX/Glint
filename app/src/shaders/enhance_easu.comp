#version 450
#extension GL_GOOGLE_include_directive : require
// Picture enhancement: AMD FidelityFX FSR 1 EASU (edge-adaptive spatial
// upsampling) from the stream's size to the window's. The FSR code is AMD's,
// unchanged (third_party/, MIT); this file only feeds it.
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba8) uniform writeonly image2D dst;
layout(binding = 1) uniform sampler2D src;      // linear sampler; EASU gathers

layout(push_constant) uniform Params {
    ivec2 src_size;
    ivec2 dst_size;
} p;

#define A_GPU 1
#define A_GLSL 1
#include "third_party/ffx_a.h"
#define FSR_EASU_F 1
AF4 FsrEasuRF(AF2 q) { return textureGather(src, q, 0); }
AF4 FsrEasuGF(AF2 q) { return textureGather(src, q, 1); }
AF4 FsrEasuBF(AF2 q) { return textureGather(src, q, 2); }
#include "third_party/ffx_fsr1.h"

void main()
{
    ivec2 at = ivec2(gl_GlobalInvocationID.xy);
    if (at.x >= p.dst_size.x || at.y >= p.dst_size.y) return;
    AU4 con0, con1, con2, con3;
    FsrEasuCon(con0, con1, con2, con3, AF1(p.src_size.x), AF1(p.src_size.y), AF1(p.src_size.x),
               AF1(p.src_size.y), AF1(p.dst_size.x), AF1(p.dst_size.y));
    AF3 c;
    FsrEasuF(c, AU2(at), con0, con1, con2, con3);
    imageStore(dst, at, vec4(clamp(c, 0.0, 1.0), 1.0));
}
