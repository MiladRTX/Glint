#version 450
// Picture enhancement: upscaling from the stream's size to the window's.
// mode 0 = bilinear, 1 = Lanczos-3 with anti-ringing (the result is clamped to
// the four nearest source pixels, so sharp edges don't get halos).
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba8) uniform writeonly image2D dst;
layout(binding = 1) uniform sampler2D src;      // linear sampler

layout(push_constant) uniform Params {
    ivec2 src_size;
    ivec2 dst_size;
    int mode;
} p;

float lanczos3(float x)
{
    x = abs(x);
    if (x < 1e-5) return 1.0;
    if (x >= 3.0) return 0.0;
    float px = 3.14159265 * x;
    return 3.0 * sin(px) * sin(px / 3.0) / (px * px);
}

void main()
{
    ivec2 at = ivec2(gl_GlobalInvocationID.xy);
    if (at.x >= p.dst_size.x || at.y >= p.dst_size.y) return;
    vec2 uv = (vec2(at) + 0.5) / vec2(p.dst_size);

    if (p.mode == 0) {
        imageStore(dst, at, vec4(textureLod(src, uv, 0.0).rgb, 1.0));
        return;
    }

    vec2 pos = uv * vec2(p.src_size) - 0.5;   // in source texel centres
    vec2 base = floor(pos);
    vec2 f = pos - base;
    float wx[6], wy[6];
    float sx = 0.0, sy = 0.0;
    for (int i = 0; i < 6; i++) {
        wx[i] = lanczos3(f.x - float(i - 2)); sx += wx[i];
        wy[i] = lanczos3(f.y - float(i - 2)); sy += wy[i];
    }
    vec3 sum = vec3(0.0);
    vec3 lo = vec3(1.0), hi = vec3(0.0);
    ivec2 b = ivec2(base);
    for (int y = 0; y < 6; y++) {
        vec3 row = vec3(0.0);
        for (int x = 0; x < 6; x++) {
            ivec2 t = clamp(b + ivec2(x - 2, y - 2), ivec2(0), p.src_size - 1);
            vec3 s = texelFetch(src, t, 0).rgb;
            row += s * wx[x];
            if ((x == 2 || x == 3) && (y == 2 || y == 3)) { lo = min(lo, s); hi = max(hi, s); }
        }
        sum += row * wy[y];
    }
    vec3 c = sum / (sx * sy);
    imageStore(dst, at, vec4(clamp(c, lo, hi), 1.0));
}
