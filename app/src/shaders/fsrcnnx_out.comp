#version 450
// AI upscaler, output at twice the stream's size. The network's last layer
// gives four luma values per source pixel (one per 2x2 output pixel, mpv's
// "aggregation" step); the colour comes from a bilinear 2x of the picture,
// whose luma is replaced by the network's.
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba8) uniform writeonly image2D dst;
layout(binding = 1) uniform sampler2D subconv;  // FSRCNNX SUBCONV1, stream size
layout(binding = 2) uniform sampler2D colour;   // the cleaned-up picture, stream size, linear

layout(push_constant) uniform Params { ivec2 src_size; } p;

void main()
{
    ivec2 at = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = p.src_size * 2;
    if (at.x >= size.x || at.y >= size.y) return;
    ivec2 idx = at & 1;
    vec4 s = texelFetch(subconv, at >> 1, 0);
    float y_net = s[idx.x * 2 + idx.y];
    vec3 rgb = textureLod(colour, (vec2(at) + 0.5) / vec2(size), 0.0).rgb;
    const vec3 k = vec3(0.2126, 0.7152, 0.0722);
    rgb += y_net - dot(rgb, k);
    imageStore(dst, at, vec4(clamp(rgb, 0.0, 1.0), 1.0));
}
