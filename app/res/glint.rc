// Glint.exe resources: the icon (Explorer, taskbar, title bar: GLFW picks up
// GLFW_ICON for its windows) and the version shown in the file's Properties.
// glint.ico comes from tools/make_brand.py.
#include <winver.h>

GLFW_ICON ICON "glint.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,2,1,0
PRODUCTVERSION 1,2,1,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Glint"
      VALUE "FileVersion", "1.2.1"
      VALUE "ProductName", "Glint"
      VALUE "ProductVersion", "1.2.1"
      VALUE "OriginalFilename", "Glint.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
